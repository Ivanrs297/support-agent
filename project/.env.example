# Copy to .env for local development. Never commit the real file.
#   cp .env.example .env

# Required. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Required. Any long random string; both the API and its browser interface use
# it. Generate one with:  openssl rand -hex 32
API_TOKEN=

# Refusing wrong tokens and limiting accepted ones. Defaults shown.
MAX_TOKEN_ATTEMPTS=5          # wrong tokens from one address before a lockout
LOCKOUT_SECONDS=900           # how long that address is refused
RATE_LIMIT_PER_MINUTE=10      # accepted requests per token per minute
DAILY_REQUEST_CAP=500         # calls to Groq per day, across every caller

# Optional. Defaults shown.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2
MAX_DOC_RESULTS=3
REQUEST_TIMEOUT_SECONDS=60
