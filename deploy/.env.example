# Copy to .env on the host. Never commit the real file.
#   cp .env.example .env && vi .env

# Image tag to run. CI pushes both `latest` and the commit SHA;
# pin to a SHA to make rollbacks explicit.
IMAGE_TAG=latest

# --- Model provider ---
ANTHROPIC_API_KEY=

# --- Managed state (nothing stateful runs on this box) ---
# Vector DB connection string
VECTOR_DB_URL=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
