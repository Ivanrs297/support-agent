# Copy to .env on the host. Never commit the real file.
#   cp .env.example .env && vi .env
#
# The api service declares `env_file: .env`, so `docker compose up` fails
# outright if this file is missing. That is deliberate: a container that starts
# without its configuration and only fails when a guest talks to it is worse
# than one that never starts.

# Image tag to run. CI pushes both `latest` and the commit SHA;
# pin to a SHA to make rollbacks explicit.
IMAGE_TAG=latest

# Required. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Required. Any long random string; both the API and its browser interface use
# it. Generate one with:  openssl rand -hex 32
API_TOKEN=

# Refusing wrong tokens and limiting accepted ones. Defaults shown.
MAX_TOKEN_ATTEMPTS=5          # wrong tokens from one address before a lockout
LOCKOUT_SECONDS=900           # how long that address is refused
RATE_LIMIT_PER_MINUTE=10      # accepted requests per token per minute
DAILY_REQUEST_CAP=500         # calls to Groq per day, across every caller

# --- Bedrock (optional second provider) ---
# Bedrock grants access per model in the console, so there is no default here.
# List what your account can actually use:
#   aws bedrock list-foundation-models --region us-east-2 --query 'modelSummaries[].modelId'
BEDROCK_MODEL_ID=
AWS_REGION=us-east-2

# Authentication. A Bedrock API key is the simplest path — botocore picks this
# variable up on its own, and nothing else is needed. The alternative is an IAM
# instance role with bedrock:InvokeModel, which leaves no long-lived secret in
# this file; see docs/runbooks/cicd.md.
AWS_BEARER_TOKEN_BEDROCK=

# Which provider answers when a request does not name one.
DEFAULT_PROVIDER=groq

# Optional. Defaults shown.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.2
MAX_DOC_RESULTS=3
REQUEST_TIMEOUT_SECONDS=60
